# App
APP_NAME=DocIntel
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-development-secret
API_V1_PREFIX=/api/v1

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Postgres
POSTGRES_USER=docintel
POSTGRES_PASSWORD=change_me
POSTGRES_DB=docintel
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://docintel:change_me@postgres:5432/docintel
SYNC_DATABASE_URL=postgresql+psycopg2://docintel:change_me@postgres:5432/docintel

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# Embeddings (local, free)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Gemini (free tier LLM)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# File uploads
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/app/uploads

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
