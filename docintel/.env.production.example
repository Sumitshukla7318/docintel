APP_NAME=DocIntel
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=GENERATE_A_NEW_ONE_DO_NOT_REUSE_DEV_KEY
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=https://your-frontend.vercel.app

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

POSTGRES_USER=docintel
POSTGRES_PASSWORD=GENERATE_A_STRONG_PASSWORD
POSTGRES_DB=docintel
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://docintel:GENERATE_A_STRONG_PASSWORD@postgres:5432/docintel
SYNC_DATABASE_URL=postgresql+psycopg2://docintel:GENERATE_A_STRONG_PASSWORD@postgres:5432/docintel

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

GEMINI_API_KEY=your-production-gemini-key
GEMINI_MODEL=gemini-2.0-flash

MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/app/uploads
RATE_LIMIT_PER_MINUTE=60
